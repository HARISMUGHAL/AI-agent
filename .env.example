# ============================================================
#  ZYNQORA EDGE — AUTONOMOUS AI OUTREACH AGENT
#  Configuration Template
# ============================================================
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  ⚠️  NEVER commit your .env file to version control!
# ============================================================

# ---------- Google Maps Places API ----------
# Get yours at: https://console.cloud.google.com/apis/credentials
# Enable "Places API (New)" in your GCP project
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ---------- Google Gemini AI ----------
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- Gmail OAuth2 ----------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Choose "OAuth 2.0 Client ID" → "Desktop app"
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=https://ai-agent-sq2l.onrender.com/auth/callback
GMAIL_REFRESH_TOKEN=

# ---------- Google Sheets ----------
# The ID of your Google Sheet (from the sheet URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ---------- Your Business Info (for emails) ----------
YOUR_NAME=Your Full Name
YOUR_COMPANY=Zynqora Edge
YOUR_EMAIL=your.email@gmail.com
YOUR_WEBSITE=https://yourwebsite.com
YOUR_PHONE=+1234567890

# ---------- Target Locations ----------
# Comma-separated list of cities to search
TARGET_LOCATIONS=New York,Los Angeles,London,Dubai,Toronto

# ---------- Target Niches ----------
# Comma-separated list of business niches to search
TARGET_NICHES=restaurants,salons,gyms,real estate agencies,dental clinics,law firms,auto repair shops,spas,tutoring centers,pet grooming

# ---------- Autonomous Scheduler ----------
# Business hours (24h format, local time)
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=18

# How often the agent runs during business hours (minutes)
AGENT_RUN_INTERVAL_MINUTES=12

# ---------- Safe Email Engine ----------
# Account type: 'gmail' (max 150/day) or 'business' (max 250/day)
# Agent always operates at 70–80% of the limit
EMAIL_ACCOUNT_TYPE=gmail

# Warmup schedule (auto — persisted in DB, 1 day = 1 calendar day):
#   Day 1  →  20 emails/day
#   Day 2  →  30 emails/day
#   Day 3  →  50 emails/day
#   Day 4  →  70 emails/day
#   Day 5  → 100 emails/day
#   Day 6  → 120 emails/day
#   Day 7+ → dynamic (100–150 gmail / 150–250 business) at 70–80% of limit

# Batch settings (internal — do not change unless you know what you're doing):
#   Batch size:           5–10 emails (random)
#   Delay between emails: 2–5 minutes (random)
#   Delay between batches: 5–20 minutes (random)

# Anti-ban thresholds:
#   Bounce rate > 5%    → STOP sending
#   Spam complaint      → REDUCE volume
#   Error spike > 20%   → PAUSE system

# Optional: additional Gmail accounts (for account rotation every 3–7 emails)
# GMAIL_ACCOUNT_2_CLIENT_ID=
# GMAIL_ACCOUNT_2_CLIENT_SECRET=
# GMAIL_ACCOUNT_2_REFRESH_TOKEN=
# GMAIL_ACCOUNT_2_EMAIL=
# GMAIL_ACCOUNT_2_NAME=

# ---------- Server ----------
PORT=3000
